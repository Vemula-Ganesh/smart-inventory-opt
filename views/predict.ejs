<%- include('partials/header') %>

<h1 class="mb-4">Predict ABC Classification (ML Engine Simulation)</h1>

<div class="row">
  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-header bg-dark text-white fw-bold">
        Input SKU Attributes
      </div>
      <div class="card-body">
        <form action="/predict" method="POST">
          <div class="mb-3">
            <label>Machine Learning Algorithm</label>
            <select name="algorithm" class="form-select" required>
              <option value="RandomForest">Random Forest (Top Performer - 93%)</option>
              <option value="DecisionTree">Decision Tree (87%)</option>
              <option value="NaiveBayes">Naïve Bayes (74%)</option>
              <option value="KNN">KNN (54%)</option>
              <option value="SVM">SVM (Worst Performer - 40%)</option>
            </select>
          </div>
          <div class="mb-3">
            <label>Item Cost ($)</label>
            <input type="number" name="itemCost" class="form-control" required placeholder="e.g. 50">
          </div>
          <div class="mb-3">
            <label>Demand Fluctuation</label>
            <select name="demandFluct" class="form-select">
              <option value="Stable">Stable</option>
              <option value="Predictable">Predictable</option>
              <option value="Volatile">Volatile</option>
            </select>
          </div>
          <div class="mb-3">
            <label>Seasonality</label>
            <select name="seasonality" class="form-select">
              <option value="None">None</option>
              <option value="Low">Low</option>
              <option value="Medium">Medium</option>
              <option value="High">High</option>
            </select>
          </div>
          <button type="submit" class="btn btn-success w-100 fw-bold">Run Predictor</button>
        </form>
      </div>
    </div>
  </div>

  <div class="col-md-6 mt-4 mt-md-0">
    <% if (prediction) { %>
      <div class="card text-center shadow border-success">
        <div class="card-header bg-success text-white">Prediction Result</div>
        <div class="card-body py-5">
          <small class="text-muted text-uppercase fw-bold">Algorithm Used</small>
          <h4><%= algorithm %></h4>
          
          <h5 class="mt-4 mb-2">Predicted Classification</h5>
          <h1 class="display-1 fw-bold text-success"><%= prediction %></h1>
          
          <div class="mt-4 badge bg-light text-dark p-2 border">
            Algorithm Simulated Accuracy: <%= accuracy %>
          </div>
        </div>
      </div>
    <% } else { %>
      <div class="h-100 p-5 bg-white border rounded shadow-sm d-flex justify-content-center align-items-center text-muted">
        Select an algorithm and run predictor to see ML model inference.
      </div>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
