<%- include('../partials/header') %>

<div class="card shadow-sm col-md-8 mx-auto">
  <div class="card-header bg-primary text-white">
    <h4 class="m-0 fw-bold">Edit SKU Data: <%= item.SKU_ID %></h4>
  </div>
  <div class="card-body">
    <form action="/inventory/edit/<%= item._id %>?_method=PUT" method="POST">
      <div class="row g-3">
        <div class="col-md-4">
          <label>SKU ID</label>
          <input type="text" name="SKU_ID" class="form-control" value="<%= item.SKU_ID %>" required>
        </div>
        <div class="col-md-4">
          <label>Item Cost</label>
          <input type="number" step="0.01" name="Item_Cost" class="form-control" value="<%= item.Item_Cost %>" required>
        </div>
        <div class="col-md-4">
          <label>Item Count</label>
          <input type="number" name="Item_Count" class="form-control" value="<%= item.Item_Count %>" required>
        </div>

        <div class="col-md-3">
          <label>Lead Time (days)</label>
          <input type="number" name="Lead_Time" class="form-control" value="<%= item.Lead_Time %>" required>
        </div>
        <div class="col-md-3">
          <label>Shelf Life (days)</label>
          <input type="number" name="Shelf_Life" class="form-control" value="<%= item.Shelf_Life %>" required>
        </div>
        <div class="col-md-3">
          <label>EOQ</label>
          <input type="number" name="EOQ" class="form-control" value="<%= item.EOQ %>" required>
        </div>
        <div class="col-md-3">
          <label>Lead Time Variance</label>
          <input type="number" step="0.01" name="Lead_Time_Var" class="form-control" value="<%= item.Lead_Time_Var %>" required>
        </div>

        <div class="col-md-4">
          <label>Seasonality</label>
          <select name="Seasonality" class="form-select" required>
            <option value="None" <%= item.Seasonality === 'None' ? 'selected' : '' %>>None</option>
            <option value="Low" <%= item.Seasonality === 'Low' ? 'selected' : '' %>>Low</option>
            <option value="Medium" <%= item.Seasonality === 'Medium' ? 'selected' : '' %>>Medium</option>
            <option value="High" <%= item.Seasonality === 'High' ? 'selected' : '' %>>High</option>
          </select>
        </div>
        <div class="col-md-4">
          <label>Warehouse Location</label>
          <input type="text" name="WarehouseLoc" class="form-control" value="<%= item.WarehouseLoc %>" required>
        </div>
        <div class="col-md-4">
          <label>Historical Sales</label>
          <input type="number" name="Historical_Sales_Data" class="form-control" value="<%= item.Historical_Sales_Data %>" required>
        </div>

        <div class="col-md-4">
          <label>Customer Reviews (0-5)</label>
          <input type="number" step="0.1" min="0" max="5" name="Customer_Reviews" class="form-control" value="<%= item.Customer_Reviews %>" required>
        </div>
        <div class="col-md-4">
          <label>Demand Fluctuation</label>
          <select name="Demand_Fluct" class="form-select" required>
            <option value="Stable" <%= item.Demand_Fluct === 'Stable' ? 'selected' : '' %>>Stable</option>
            <option value="Volatile" <%= item.Demand_Fluct === 'Volatile' ? 'selected' : '' %>>Volatile</option>
            <option value="Predictable" <%= item.Demand_Fluct === 'Predictable' ? 'selected' : '' %>>Predictable</option>
          </select>
        </div>
        <div class="col-md-4">
          <label>ABC Classification (Target)</label>
          <select name="ABC_Classification" class="form-select" required>
            <option value="A" <%= item.ABC_Classification === 'A' ? 'selected' : '' %>>A - High Value</option>
            <option value="B" <%= item.ABC_Classification === 'B' ? 'selected' : '' %>>B - Medium Value</option>
            <option value="C" <%= item.ABC_Classification === 'C' ? 'selected' : '' %>>C - Low Value</option>
          </select>
        </div>
      </div>
      
      <div class="mt-4 text-end">
        <a href="/inventory" class="btn btn-secondary me-2">Cancel</a>
        <button type="submit" class="btn btn-primary">Update SKU</button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
