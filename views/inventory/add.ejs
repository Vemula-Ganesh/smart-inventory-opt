<%- include('../partials/header') %>

<div class="card shadow-sm col-md-8 mx-auto">
  <div class="card-header bg-success text-white">
    <h4 class="m-0 fw-bold">Add New SKU Data</h4>
  </div>
  <div class="card-body">
    <form action="/inventory/add" method="POST">
      <div class="row g-3">
        <div class="col-md-4">
          <label>SKU ID</label>
          <input type="text" name="SKU_ID" class="form-control" required>
        </div>
        <div class="col-md-4">
          <label>Item Cost</label>
          <input type="number" step="0.01" name="Item_Cost" class="form-control" required>
        </div>
        <div class="col-md-4">
          <label>Item Count</label>
          <input type="number" name="Item_Count" class="form-control" required>
        </div>

        <div class="col-md-3">
          <label>Lead Time (days)</label>
          <input type="number" name="Lead_Time" class="form-control" required>
        </div>
        <div class="col-md-3">
          <label>Shelf Life (days)</label>
          <input type="number" name="Shelf_Life" class="form-control" required>
        </div>
        <div class="col-md-3">
          <label>EOQ</label>
          <input type="number" name="EOQ" class="form-control" required>
        </div>
        <div class="col-md-3">
          <label>Lead Time Variance</label>
          <input type="number" step="0.01" name="Lead_Time_Var" class="form-control" required>
        </div>

        <div class="col-md-4">
          <label>Seasonality</label>
          <select name="Seasonality" class="form-select" required>
            <option value="None">None</option>
            <option value="Low">Low</option>
            <option value="Medium">Medium</option>
            <option value="High">High</option>
          </select>
        </div>
        <div class="col-md-4">
          <label>Warehouse Location</label>
          <input type="text" name="WarehouseLoc" class="form-control" required>
        </div>
        <div class="col-md-4">
          <label>Historical Sales</label>
          <input type="number" name="Historical_Sales_Data" class="form-control" required>
        </div>

        <div class="col-md-4">
          <label>Customer Reviews (0-5)</label>
          <input type="number" step="0.1" min="0" max="5" name="Customer_Reviews" class="form-control" required>
        </div>
        <div class="col-md-4">
          <label>Demand Fluctuation</label>
          <select name="Demand_Fluct" class="form-select" required>
            <option value="Stable">Stable</option>
            <option value="Volatile">Volatile</option>
            <option value="Predictable">Predictable</option>
          </select>
        </div>
        <div class="col-md-4">
          <label>ABC Classification (Target)</label>
          <select name="ABC_Classification" class="form-select" required>
            <option value="A">A - High Value</option>
            <option value="B">B - Medium Value</option>
            <option value="C">C - Low Value</option>
          </select>
        </div>
      </div>
      
      <div class="mt-4 text-end">
        <a href="/inventory" class="btn btn-secondary me-2">Cancel</a>
        <button type="submit" class="btn btn-success">Add SKU</button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
